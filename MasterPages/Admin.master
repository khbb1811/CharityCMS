<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.master.cs" Inherits="CharityCMS.MasterPages.Admin" %>
<!doctype html>
<html lang="ar" dir="rtl">
<head runat="server">
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%: Page.Title %> - جود</title>
  <!-- Bootstrap 5 RTL (CDN) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet" />
  <link href="~/Content/css/app.rtl.css" rel="stylesheet" />
</head>
<body>
<form id="form1" runat="server">

  <!-- Sidebar (Desktop) -->
  <div class="sidebar d-none d-lg-block p-3">
    <div class="d-flex align-items-center gap-2 mb-4">
      <div class="rounded-circle bg-white bg-opacity-10 d-inline-flex align-items-center justify-content-center" style="width:44px;height:44px;">🏛️</div>
      <div>
        <div class="fw-bold">جود - Jood</div>
        <small class="opacity-75"></small>
      </div>
    </div>

    <nav class="d-grid gap-1">
     
 <a class="py-2 px-2 rounded" href="/Pages/Dashboard/Default.aspx">الرئيسية</a>
  <a class="py-2 px-2 rounded" href="/Pages/Beneficiaries/List.aspx">المستفيدون</a>
  <a class="py-2 px-2 rounded" href="/Pages/Donations/List.aspx">التبرعات</a>
  <a class="py-2 px-2 rounded" href="/Pages/Inventory/Items.aspx">المخزون</a>
  <a class="py-2 px-2 rounded" href="/Pages/Distributions/History.aspx">التوزيعات</a>

      
 <%-- <a class="py-2 px-2 rounded" href="/Pages/EmergencyCases/List.aspx">حالات الطوارئ</a>--%>
  <a class="py-2 px-2 rounded" href="/Pages/Dashboard/Default.aspx">التقارير</a>
        <%--<a class="py-2 px-2 rounded" href="/Pages/Reports/Monthly.aspx">التقارير</a>--%>
 <a class="py-2 px-2 rounded" href="/Pages/Auth/Register.aspx">مدير النظام</a>
 
<asp:HyperLink ID="lnkSupport" runat="server"
    CssClass="py-2 px-2 rounded"
    NavigateUrl="/Pages/Auth/Registerkhaled.aspx" >
    الدعم الفني
</asp:HyperLink>


    </nav>
  </div>

  <!-- Content -->
  <div class="content-wrap">

    <!-- Topbar -->
    <div class="topbar border-bottom py-2 px-3 sticky-top">
      <div class="d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2">
          <!-- Mobile menu button -->
          <button class="btn btn-outline-primary d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar">☰</button>
          <div>
            <div class="fw-bold"><asp:Label ID="lblPageTitle" runat="server" Text="لوحة التحكم"></asp:Label></div>
            <%--<small class="text-muted">واجهة عربية RTL — تصميم مؤسسي</small>--%>
          </div>
        </div>
        <div class="d-flex align-items-center gap-2">
          <span class="text-muted small">مرحبًا،</span>
          <asp:Label ID="lblUser" runat="server" CssClass="fw-semibold" />
          <asp:LinkButton ID="btnLogout" runat="server" CssClass="btn btn-sm btn-outline-danger" OnClick="btnLogout_Click">تسجيل خروج</asp:LinkButton>
        </div>
      </div>
    </div>

    <main class="p-3 p-lg-4">
      <asp:ContentPlaceHolder ID="MainContent" runat="server" />
    </main>
  </div>

  <!-- Mobile Sidebar -->
  <div class="offcanvas offcanvas-end" tabindex="-1" id="mobileSidebar">
    <div class="offcanvas-header">
      <h5 class="offcanvas-title">القائمة</h5>
      <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
      <div class="d-grid gap-2">

        <a class="py-2 px-2 rounded" href="/Pages/Dashboard/Default.aspx">الرئيسية</a>
        <a class="py-2 px-2 rounded" href="/Pages/Beneficiaries/List.aspx">المستفيدون</a>
        <a class="py-2 px-2 rounded" href="/Pages/Donations/List.aspx">التبرعات</a>
        <a class="py-2 px-2 rounded" href="/Pages/Inventory/Items.aspx">المخزون</a>
        <a class="py-2 px-2 rounded" href="/Pages/Distributions/History.aspx">التوزيعات</a>
        <a class="py-2 px-2 rounded" href="/Pages/EmergencyCases/List.aspx">حالات الطوارئ</a>
        <a class="py-2 px-2 rounded" href="/Pages/Reports/Monthly.aspx">التقارير</a>

    </div>
    </div>
  </div>

</form>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/Scripts/app.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
