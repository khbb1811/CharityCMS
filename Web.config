<?xml version="1.0" encoding="utf-8"?>
<configuration>

	<!-- الكود المحلي 
	<connectionStrings>
		<add name="CharityCMS_DB"
			 connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=CharityCMS_DB;Integrated Security=True;TrustServerCertificate=True"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>
-->
	<!--  كود السيرفر  -->
	<connectionStrings>
		<add name="CharityCMS_DB"
			 connectionString="Data Source=CharityDB.mssql.somee.com;Initial Catalog=CharityDB;User ID=khaledelbarbary_SQLLogin_1;Password=gmelc6fprz;TrustServerCertificate=True"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>

	<appSettings>
    <add key="HashIterations" value="10000" />
    <add key="AppName" value="CharityCMS" />

		<add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
		
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" requestValidationMode="4.5" />

    <authentication mode="Forms">
      <forms loginUrl="~/Pages/Auth/Login.aspx" timeout="120" slidingExpiration="true" />
    </authentication>

    <authorization>
      <deny users="?" />
    </authorization>

    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID" />

    <customErrors mode="Off" />


	  <globalization
			  requestEncoding="utf-8"
			  responseEncoding="utf-8"
			  fileEncoding="utf-8" />
	  
	  <sessionState cookieless="UseCookies" timeout="30" />
	  
  </system.web>

  <!-- السماح بصفحات الدخول بدون تسجيل -->
  <location path="Pages/Auth">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Pages/Dashboard/Default.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>



</configuration>
